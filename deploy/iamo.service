[Unit]
Description=IAMO Core - DesarrollAMO root operational agent
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/IAMO
Environment=PYTHONUNBUFFERED=1
Environment=IAMOX_ROOT=%h/IAMOX
Environment=IAMO_SOCIAL_BUDGET=3
Environment=IAMO_SOCIAL_MODEL=qwen2.5:1.5b
Environment=IAMO_CODER_MODEL=qwen2.5-coder:3b
ExecStart=/usr/bin/python3 main.py serve --interval 180
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
